# Kopiere diese Datei nach .env und passe die Werte an.

# JWT-Signaturschlüssel (unbedingt in Produktion ändern!)
JWT_SECRET=bitte-aendern-langer-zufaelliger-string

# NiceGUI Session-Secret (unbedingt in Produktion ändern!)
NICEGUI_SECRET=bitte-aendern-langer-zufaelliger-string

# Initialer Admin-Nutzer (wird nur beim ersten Start angelegt)
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=sicheres-passwort-hier

# Port der App (Standard: 8080)
APP_PORT=8080
